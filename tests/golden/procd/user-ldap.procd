#!/bin/sh /etc/rc.common
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: user-ldap.service
# Source: /usr/lib/systemd/system/user-ldap.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:010f47cf63468a25
# Generator: fake-systemd 0.1.0 procd/1
# Daemon that runs as a directory-service account
# User=svc-directory is not in /etc/passwd: the executor cannot switch to it

USE_PROCD=1
START=50
STOP=50

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/fake-systemd --exec user-ldap.service --log
	procd_set_param respawn 10 2 5
	procd_set_param term_timeout 90
	procd_close_instance
}

service_stopped() {
	_n=0
	while procd_running user-ldap && [ "$_n" -lt 95 ]; do
		sleep 1
		_n=$((_n + 1))
	done
}

reload_service() {
	echo "user-ldap.service does not support reload" >&2
	return 3
}
