#!/bin/sh /etc/rc.common
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: user-group.service
# Source: /usr/lib/systemd/system/user-group.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:b07fcdd1ffc08036
# Generator: fake-systemd 0.1.0 procd/1
# Daemon with user, group and supplementary groups

USE_PROCD=1
START=50
STOP=50

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/fake-systemd --exec user-group.service --log
	procd_set_param term_timeout 90
	procd_close_instance
}

service_stopped() {
	_n=0
	while procd_running user-group && [ "$_n" -lt 95 ]; do
		sleep 1
		_n=$((_n + 1))
	done
}

reload_service() {
	echo "user-group.service does not support reload" >&2
	return 3
}
