#!/bin/sh /etc/rc.common
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: forking-pidfile.service
# Source: /usr/lib/systemd/system/forking-pidfile.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:15267ff4c4880d61
# Generator: fake-systemd 0.1.0 procd/1
# Legacy forking daemon
# Restart=on-abnormal is approximated by respawning on every exit

USE_PROCD=1
START=50
STOP=50

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/fake-systemd --exec forking-pidfile.service --log
	procd_set_param respawn 10 1 5
	procd_set_param term_timeout 90
	procd_close_instance
}

service_stopped() {
	_n=0
	while procd_running forking-pidfile && [ "$_n" -lt 95 ]; do
		sleep 1
		_n=$((_n + 1))
	done
}

reload_service() {
	echo "forking-pidfile.service does not support reload" >&2
	return 3
}
