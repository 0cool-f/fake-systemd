# Bus-activated helper

USE_PROCD=1
START=50
STOP=50

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/fake-systemd --exec dbus-activated.service --log
	procd_set_param term_timeout 90
	procd_close_instance
}

service_stopped() {
	_n=0
	while procd_running dbus-activated && [ "$_n" -lt 95 ]; do
		sleep 1
		_n=$((_n + 1))
	done
}

reload_service() {
	echo "dbus-activated.service does not support reload" >&2
	return 3
}
