		if [ -z "$_pid" ]; then
			_code=$(echo "$_list" | jsonfilter -e '@["exec-quoting"].instances[*].exit_code')
			case $_code in 0) return 0 ;; ?*) break ;; esac
		fi
		_i=$((_i + 1))
		[ "$_i" -lt 20 ] || sleep 0.05 2>/dev/null || sleep 1
	done
