#!/bin/sh /etc/rc.common
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: restart-always.service
# Source: /usr/lib/systemd/system/restart-always.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:3f7ce0ba12f1d53d
# Generator: fake-systemd 0.1.0 procd/1
# Always restarted worker
# KillSignal= is not honored: procd stops an instance with SIGTERM

USE_PROCD=1
START=50
STOP=50

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/fake-systemd --exec restart-always.service --log
	procd_set_param respawn 10 5 5
	procd_set_param term_timeout 2
	procd_close_instance
}

service_stopped() {
	_n=0
	while procd_running restart-always && [ "$_n" -lt 7 ]; do
		sleep 1
		_n=$((_n + 1))
	done
}

reload_service() {
	echo "restart-always.service does not support reload" >&2
	return 3
}
