#!/bin/sh /etc/rc.common
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: deps-mix.service
# Source: /usr/lib/systemd/system/deps-mix.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:3d54e4783ecae10b
# Generator: fake-systemd 0.1.0 procd/1
# Service with many dependency kinds
# Requires: dbus postgresql

USE_PROCD=1
START=50
STOP=50

start_service() {
	/etc/init.d/dbus start || {
		echo "deps-mix.service: cannot start dbus" >&2
		return 1
	}
	/etc/init.d/postgresql start || {
		echo "deps-mix.service: cannot start postgresql" >&2
		return 1
	}
	procd_open_instance
	procd_set_param command /usr/bin/fake-systemd --exec deps-mix.service --log
	procd_set_param term_timeout 90
	procd_close_instance
}

service_stopped() {
	_n=0
	while procd_running deps-mix && [ "$_n" -lt 95 ]; do
		sleep 1
		_n=$((_n + 1))
	done
}

reload_service() {
	echo "deps-mix.service does not support reload" >&2
	return 3
}
