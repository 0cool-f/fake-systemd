#!/bin/sh /etc/rc.common
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: tpl-login@tty1.service
# Source: /usr/lib/systemd/system/tpl-login@.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:e338950ffd85f238
# Generator: fake-systemd 0.1.0 procd/1
# Login prompt on tty1

USE_PROCD=1
START=50
STOP=50

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/fake-systemd --exec tpl-login@tty1.service --log
	procd_set_param respawn 10 1 5
	procd_set_param term_timeout 90
	procd_close_instance
}

service_stopped() {
	_n=0
	while procd_running tpl-login.tty1 && [ "$_n" -lt 95 ]; do
		sleep 1
		_n=$((_n + 1))
	done
}

reload_service() {
	echo "tpl-login@tty1.service does not support reload" >&2
	return 3
}
