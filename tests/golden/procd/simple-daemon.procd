#!/bin/sh /etc/rc.common
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: simple-daemon.service
# Source: /usr/lib/systemd/system/simple-daemon.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:10a3502168bf0f48
# Generator: fake-systemd 0.1.0 procd/1
# Example metrics exporter
# Restart=on-failure is approximated by respawning on every exit

USE_PROCD=1
START=50
STOP=50

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/fake-systemd --exec simple-daemon.service --log
	procd_set_param respawn 10 1 5
	procd_set_param term_timeout 90
	procd_close_instance
}

service_stopped() {
	_n=0
	while procd_running simple-daemon && [ "$_n" -lt 95 ]; do
		sleep 1
		_n=$((_n + 1))
	done
}

reload_service() {
	echo "simple-daemon.service does not support reload" >&2
	return 3
}
