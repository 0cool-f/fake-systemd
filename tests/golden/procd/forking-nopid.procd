status() {
	case $(cat "$exit_file" 2>/dev/null) in
	ok*)
		echo "forking-nopid.service is active (exited)"
		return 0
		;;
	failed*)
		echo "forking-nopid.service failed"
		return 1
		;;
	esac
	echo "forking-nopid.service is not running"
	return 3
}

running() {
	case $(cat "$exit_file" 2>/dev/null) in
	ok*) return 0 ;;
	esac
	return 1
}

reload() {
	echo "forking-nopid.service does not support reload" >&2
