STOP=50
EXTRA_COMMANDS="status running"
state_dir=/run/fake-systemd
log_dir=/var/log/fake-systemd/forking-nopid.service
main_pid=/run/fake-systemd/forking-nopid.service.pid
exit_file=/run/fake-systemd/forking-nopid.service.exit

start() {
	case $(cat "$exit_file" 2>/dev/null) in
	ok*) return 0 ;;
	esac
	mkdir -p "$state_dir" "$log_dir" || return 1
	/usr/bin/fake-systemd --exec forking-nopid.service --log --record-exit > /dev/null
