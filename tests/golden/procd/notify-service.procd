#!/bin/sh /etc/rc.common
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: notify-service.service
# Source: /usr/lib/systemd/system/notify-service.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:c9dc1127c02bec48
# Generator: fake-systemd 0.1.0 procd/2
# Notify-style database
# KillSignal= is not honored: procd stops an instance with SIGTERM

USE_PROCD=1
START=50
STOP=50

main_pid=/run/fake-systemd/notify-service.service.pid
start_wait=90
main_replaced=0

registered() {
	[ -n "$(ubus call service list '{"name": "notify-service"}' | jsonfilter -e '@["notify-service"]')" ]
}

start_service() {
	procd_running notify-service || rm -f "$main_pid"
	procd_open_instance
	procd_set_param command /usr/bin/fake-systemd --exec notify-service.service --log
	procd_set_param term_timeout 45
	procd_close_instance
}

service_started() {
	_end=$(($(date +%s) + start_wait))
	_i=0
	while [ "$(date +%s)" -le "$_end" ]; do
		_list=$(ubus call service list '{"name": "notify-service"}')
		_pid=$(echo "$_list" | jsonfilter -e '@["notify-service"].instances[*].pid')
		if [ -s "$main_pid" ]; then
			[ "$main_replaced" -eq 0 ] && return 0
			if [ -n "$_pid" ]; then
				read _main _ < "$main_pid"
				[ "$_main" != "$_pid" ] && return 0
			fi
		fi
		if [ -z "$_pid" ]; then
			_code=$(echo "$_list" | jsonfilter -e '@["notify-service"].instances[*].exit_code')
			case $_code in 0) return 0 ;; ?*) break ;; esac
		fi
		_i=$((_i + 1))
		[ "$_i" -lt 20 ] || sleep 0.05 2>/dev/null || sleep 1
	done
	echo "notify-service.service did not come up" >&2
	return 1
}

service_stopped() {
	_n=0
	while procd_running notify-service && [ "$_n" -lt 50 ]; do
		sleep 1
		_n=$((_n + 1))
	done
}

reload_service() {
	procd_running notify-service || {
		echo "notify-service.service is not running" >&2
		return 7
	}
	/usr/bin/fake-systemd --exec notify-service.service --phase reload
}
