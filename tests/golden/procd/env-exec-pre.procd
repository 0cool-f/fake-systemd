	procd_set_param term_timeout 90
	procd_set_param file /etc/default/webapp
	procd_close_instance
}

service_stopped() {
	_n=0
	while procd_running env-exec-pre && [ "$_n" -lt 95 ]; do
		sleep 1
		_n=$((_n + 1))
	done
}

reload_service() {
