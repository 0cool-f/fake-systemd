# Daemon with reload and stop hooks

USE_PROCD=1
START=50
STOP=50

registered() {
	[ -n "$(ubus call service list '{"name": "reload-stop"}' | jsonfilter -e '@["reload-stop"]')" ]
}

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/fake-systemd --exec reload-stop.service --stop-on-signal --log
	procd_set_param term_timeout 100
	procd_close_instance
}

stop_service() {
	registered && _was_up=1
}

service_stopped() {
	_n=0
	while procd_running reload-stop && [ "$_n" -lt 105 ]; do
		sleep 1
		_n=$((_n + 1))
	done
	[ -n "$_was_up" ] && /usr/bin/fake-systemd --exec reload-stop.service --phase stop-post
}

reload_service() {
	procd_running reload-stop || {
		echo "reload-stop.service is not running" >&2
		return 7
	}
	/usr/bin/fake-systemd --exec reload-stop.service --phase reload
}
