# Generator: fake-systemd 0.1.0 s6-rc/1
clean=
case "$1" in
256) case "$2" in 1|2|13|15) clean=1 ;; esac ;;
0) clean=1 ;;
esac
if [ -n "$clean" ]; then verdict=ok; else verdict=failed; fi
printf '%s %s %s\n' "$verdict" "$1" "$2" > ./supervise/exit-status
s6-svc -O .
