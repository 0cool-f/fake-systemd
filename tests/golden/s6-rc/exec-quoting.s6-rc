#!/bin/sh
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: exec-quoting.service
# Source: /usr/lib/systemd/system/exec-quoting.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:8e93c9bf98a61038
# Generator: fake-systemd 0.1.0 s6-rc/1
exec 2>&1
export PLAIN=1
export SPACED='a b'
export PRICE='cost $5'
export HASH='a#b'
exec /usr/bin/quoter --name 'two words' --tag its '--path=/tmp/x#y' '--cost=$5' --empty ''
