				[ "$main_child" -eq 0 ] && return 0
				read _main _ < "$main_pid"
				[ "$_main" != "$_pid" ] && return 0
			fi
		else
			_dead=$(cat "$daemon_pid" 2>/dev/null)
			case $_dead in ''|*[!0-9]*) ;; *) [ -d "/proc/$_dead" ] || { [ -e "$exit_file" ] && return 0; break; } ;; esac
		fi
