stop_wait=100
start_wait=90
main_child=1
lock_file=/var/lock/subsys/exec-vars

running() {
	_pid=$(cat "$daemon_pid" 2>/dev/null)
	case $_pid in ''|*[!0-9]*) return 1 ;; esac
	[ "$_pid" -gt 1 ] && [ "$(cat "/proc/$_pid/comm" 2>/dev/null)" = fake-systemd ]
