}

stop_daemon() {
	running || return 0
	kill -TERM "$_pid" 2>/dev/null
	_n=0
	while running && [ "$_n" -lt $((stop_wait * 10)) ]; do
		sleep 0.1
		_n=$((_n + 1))
	done
	running || return 0
	kill -KILL "$_pid" 2>/dev/null
