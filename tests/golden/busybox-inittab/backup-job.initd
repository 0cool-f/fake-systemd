state_dir=/run/fake-systemd
log_dir=/var/log/fake-systemd/backup-job.service
main_pid=/run/fake-systemd/backup-job.service.pid
exit_file=/run/fake-systemd/backup-job.service.exit

do_start() {
	mkdir -p "$state_dir" "$log_dir" || return 1
