#!/bin/sh
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: user-group.service
# Source: /usr/lib/systemd/system/user-group.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:4c21d82c12397eb8
# Generator: fake-systemd 0.1.0 bsd-rc/1
# Daemon with user, group and supplementary groups

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
state_dir=/run/fake-systemd
log_dir=/var/log/fake-systemd/user-group.service
main_pid=/run/fake-systemd/user-group.service.pid
exit_file=/run/fake-systemd/user-group.service.exit
daemon_pid=/run/fake-systemd/user-group.service.daemon.pid
stop_wait=100

running() {
	_pid=$(cat "$daemon_pid" 2>/dev/null)
	[ -n "$_pid" ] && [ "$(cat "/proc/$_pid/comm" 2>/dev/null)" = fake-systemd ]
}

do_start() {
	running && return 0
	mkdir -p "$state_dir" "$log_dir" || return 1
	rm -f "$exit_file" "$main_pid"
	echo "Starting user-group.service"
	/usr/bin/fake-systemd --exec user-group.service --daemon --log --record-exit
}

stop_daemon() {
	running || return 0
	_pid=$(cat "$daemon_pid")
	kill -TERM "$_pid" 2>/dev/null
	_n=0
	while running && [ "$_n" -lt $((stop_wait * 10)) ]; do
		sleep 0.1
		_n=$((_n + 1))
	done
	running || return 0
	kill -KILL "$_pid" 2>/dev/null
	_n=0
	while running && [ "$_n" -lt 50 ]; do
		sleep 0.1
		_n=$((_n + 1))
	done
	! running
}

do_stop() {
	rc=0
	if [ -e "$daemon_pid" ]; then
		echo "Stopping user-group.service"
		stop_daemon || rc=$?
		rm -f "$daemon_pid"
	fi
	rm -f "$main_pid" "$exit_file"
	return "$rc"
}

do_status() {
	if running; then
		echo "user-group.service is running"
		return 0
	fi
	case $(cat "$exit_file" 2>/dev/null) in
	ok*)
		echo "user-group.service is not running"
		return 3
		;;
	esac
	if [ -e "$daemon_pid" ] || [ -e "$exit_file" ]; then
		echo "user-group.service is dead"
		return 1
	fi
	echo "user-group.service is not running"
	return 3
}

case "$1" in
start)
	do_start
	;;
stop)
	do_stop
	;;
restart)
	do_stop
	do_start
	;;
reload)
	echo "user-group.service does not support reload" >&2
	exit 3
	;;
status)
	do_status
	;;
*)
	echo "usage: $0 start|stop|restart|reload|status" >&2
	exit 2
	;;
esac
