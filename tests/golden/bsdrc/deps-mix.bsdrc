#!/bin/sh
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: deps-mix.service
# Source: /usr/lib/systemd/system/deps-mix.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:067f511efffca72d
# Generator: fake-systemd 0.1.0 bsd-rc/1
# Service with many dependency kinds
# Requires: dbus postgresql
# Wants: syslog
# network.target: rc.local runs after rc.inet1 and rc.inet2, which bring the network up

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
script_dir=/etc/rc.d
state_dir=/run/fake-systemd
log_dir=/var/log/fake-systemd/deps-mix.service
main_pid=/run/fake-systemd/deps-mix.service.pid
exit_file=/run/fake-systemd/deps-mix.service.exit
daemon_pid=/run/fake-systemd/deps-mix.service.daemon.pid
stop_wait=100

start_dep() {
	_s="$script_dir/rc.$1"
	[ -e "$_s" ] || return 1
	if [ -x "$_s" ]; then "$_s" start; else sh "$_s" start; fi
}

running() {
	_pid=$(cat "$daemon_pid" 2>/dev/null)
	[ -n "$_pid" ] && [ "$(cat "/proc/$_pid/comm" 2>/dev/null)" = fake-systemd ]
}

do_start() {
	running && return 0
	start_dep dbus || {
		echo "deps-mix.service: cannot start dbus" >&2
		return 1
	}
	start_dep postgresql || {
		echo "deps-mix.service: cannot start postgresql" >&2
		return 1
	}
	start_dep syslog || :
	mkdir -p "$state_dir" "$log_dir" || return 1
	rm -f "$exit_file" "$main_pid"
	echo "Starting deps-mix.service"
	/usr/bin/fake-systemd --exec deps-mix.service --daemon --log --record-exit
}

stop_daemon() {
	running || return 0
	_pid=$(cat "$daemon_pid")
	kill -TERM "$_pid" 2>/dev/null
	_n=0
	while running && [ "$_n" -lt $((stop_wait * 10)) ]; do
		sleep 0.1
		_n=$((_n + 1))
	done
	running || return 0
	kill -KILL "$_pid" 2>/dev/null
	_n=0
	while running && [ "$_n" -lt 50 ]; do
		sleep 0.1
		_n=$((_n + 1))
	done
	! running
}

do_stop() {
	rc=0
	if [ -e "$daemon_pid" ]; then
		echo "Stopping deps-mix.service"
		stop_daemon || rc=$?
		rm -f "$daemon_pid"
	fi
	rm -f "$main_pid" "$exit_file"
	return "$rc"
}

do_status() {
	if running; then
		echo "deps-mix.service is running"
		return 0
	fi
	case $(cat "$exit_file" 2>/dev/null) in
	ok*)
		echo "deps-mix.service is not running"
		return 3
		;;
	esac
	if [ -e "$daemon_pid" ] || [ -e "$exit_file" ]; then
		echo "deps-mix.service is dead"
		return 1
	fi
	echo "deps-mix.service is not running"
	return 3
}

case "$1" in
start)
	do_start
	;;
stop)
	do_stop
	;;
restart)
	do_stop
	do_start
	;;
reload)
	echo "deps-mix.service does not support reload" >&2
	exit 3
	;;
status)
	do_status
	;;
*)
	echo "usage: $0 start|stop|restart|reload|status" >&2
	exit 2
	;;
esac
