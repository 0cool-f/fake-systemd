# flags: transient
# A oneshot stays started in OpenRC; status reads it as inactive
description='Nightly backup (started by backup-job.timer)'

start() {
	ebegin "Starting ${RC_SVCNAME}"
	exec 4>&1
	_rc=$( { { /usr/bin/fake-systemd --exec backup-job.service 2>&1; echo $? >&3; } | /usr/bin/fake-systemd --log backup-job.service >&4; } 3>&1 )
