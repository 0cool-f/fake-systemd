#!/sbin/openrc-run
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: simple-daemon.service
# Source: /usr/lib/systemd/system/simple-daemon.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:3611dd2cb796bd7b
# Generator: fake-systemd 0.1.0 openrc/2
# Restart=on-failure is approximated by respawning on every exit
description='Example metrics exporter'
supervisor=supervise-daemon
command=/usr/bin/exporter
command_args="--listen 127.0.0.1:9100 --log.level=info"
retry=TERM/90/KILL/5
respawn_delay=1
respawn_max=5
respawn_period=10
output_logger='/usr/bin/fake-systemd --log simple-daemon.service'
error_logger='/usr/bin/fake-systemd --log simple-daemon.service'

depend() {
	use net
}
