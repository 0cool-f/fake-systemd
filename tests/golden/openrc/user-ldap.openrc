description='Daemon that runs as a directory-service account'
supervisor=supervise-daemon
command=/usr/bin/dirsync
command_args="--interval 300"
command_user=svc-directory
retry=TERM/90/KILL/5
respawn_delay=2
respawn_max=5
respawn_period=10
output_logger='/usr/bin/fake-systemd --log user-ldap.service'
error_logger='/usr/bin/fake-systemd --log user-ldap.service'

depend() {
	use net
}

start_pre() {
	mkdir -p /var/log/fake-systemd/user-ldap.service &&
		checkpath -q -d -m 0755 -o svc-directory /var/log/fake-systemd/user-ldap.service
}
