clean=
case "$1" in
-1) case $(($2 & 127)) in 1|2|13|15) clean=1 ;; esac ;;
0) clean=1 ;;
esac
if [ -n "$clean" ]; then verdict=ok; else verdict=failed; fi
printf '%s %s %s\n' "$verdict" "$1" "$2" > ./supervise/exit-status
case "$(cat supervise/stat)" in *"want "*) ;; *) sv once . ;; esac
