#!/bin/sh
# Generated automatically by fake-systemd. Remove this block to take ownership of the file.
# Unit: deps-mix.service
# Source: /usr/lib/systemd/system/deps-mix.service
# Source-Hash: xxh3:0123456789abcdef
# Body-Hash: xxh3:a820b074d650e9d4
# Generator: fake-systemd 0.1.0 s6/3
exec 2>&1
wait_supervised() {
    s6-svok "$1" 2>/dev/null || s6-svscanctl -a "${1%/*}" 2>/dev/null
    n=0
    until s6-svok "$1" 2>/dev/null && s6-svstat "$1" >/dev/null 2>&1; do
        n=$((n + 1))
        if [ "$n" -gt "$2" ]; then
            echo "no s6-supervise runs for $1" >&2
            return 1
        fi
        sleep 0.25
    done
}
wait_supervised /service/dbus 360 || exit 1
s6-svc -u /service/dbus 2>/dev/null
s6-svwait -u -t 90000 /service/dbus || exit 1
wait_supervised /service/postgresql 360 || exit 1
s6-svc -u /service/postgresql 2>/dev/null
s6-svwait -u -t 90000 /service/postgresql || exit 1
wait_supervised /service/syslog 20 || :
s6-svc -u /service/syslog 2>/dev/null
s6-svwait -u -t 5000 /service/syslog || :
exec /usr/bin/depsvc
