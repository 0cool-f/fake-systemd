# Debian with GNU Shepherd, from the dated tag of 2026-09-18. The shepherd package comes from the
# trixie archive of the day the image is built, so the version is printed by the test.
FROM docker.io/library/debian:trixie-20260918-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends shepherd procps util-linux libnss-extrausers && rm -rf /var/lib/apt/lists/*
