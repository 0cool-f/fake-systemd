# Debian with finit, from the dated tag of 2026-09-18. The finit and finit-sysv packages come from
# the trixie archive of the day the image is built, so the finit version is printed by the test.
FROM docker.io/library/debian:trixie-20261027-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4

RUN apt-get -o Acquire::Retries=5 update -qq && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y -qq --no-install-recommends finit procps util-linux libnss-extrausers && rm -rf /var/lib/apt/lists/*
