# Debian with nosh 1.41 from the binary packages of its author, fetched by fetch-debs.sh into debs/ and
# checked again here against debs.sha256 before they are installed.
FROM docker.io/library/debian:trixie-20260918-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

COPY debs.sha256 /debs/debs.sha256
COPY debs/ /debs/
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends ca-certificates procps util-linux \
    && (cd /debs && sha256sum -c debs.sha256) \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends /debs/*.deb \
    && rm -rf /debs /var/lib/apt/lists/*
