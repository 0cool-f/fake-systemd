# Debian with nosh 1.41 from the binary packages of its author, fetched by fetch-debs.sh into debs/ and
# checked again here against debs.sha256 before they are installed.
FROM docker.io/library/debian:trixie-20261027-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4

COPY debs.sha256 /debs/debs.sha256
COPY debs/ /debs/
RUN apt-get -o Acquire::Retries=5 update -qq && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y -qq --no-install-recommends ca-certificates procps util-linux \
    && (cd /debs && sha256sum -c debs.sha256) \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y -qq --no-install-recommends /debs/*.deb \
    && rm -rf /debs /var/lib/apt/lists/*
