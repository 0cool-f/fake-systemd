# Rocky Linux 9 carries chkconfig 1.24, the version before the one of Rocky 10; see ../redhat.
FROM docker.io/rockylinux/rockylinux:9.8@sha256:8101994123cf3d0a8fee517bee7f39e555c7d92bd2d9eb3303cc988a0eeed00f

RUN dnf install -y -q chkconfig initscripts initscripts-service procps-ng util-linux findutils && dnf clean all -q
RUN cp /usr/bin/bash /usr/local/sbin/init
