# Devuan packages OpenRC 0.45 and leaves start-stop-daemon to dpkg.
FROM docker.io/devuan/devuan:daedalus-2026-09-22@sha256:c86ebfe2f107943119e1c565374866bc8b34942bc56ccfcc56bbb706ab770dcb

RUN apt-get -o Acquire::Retries=5 update -qq && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y -qq --no-install-recommends openrc procps && rm -rf /var/lib/apt/lists/*
